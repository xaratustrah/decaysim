# decaysim -- 98Mo from ONE source: the RionSIS export (section 11 of staircase_analysis_final_v2.ipynb)
# With rionsis_file set, these come from the file and the values here are IGNORED:
#   mean_ion_number, mean_ion, mean_bkgnd, stdv_ion, stdv_bkgnd, timestep, n_sim, n_sim_steps,
#   tau_seed, max_ions, exp_decay_file, exp_injections_file  (the log lists every value taken)

[params]
max_ions = 47   # from RionSIS
rionsis_file = "/home/carlo/Desktop/PhD/coding/results/Mo/files/rionsis_export_Mo.npz"

# placeholders (required by the parser, overwritten from rionsis_file)
tau_seed = 2.669037e-01
timestep = 1.001819e-02
n_sim_steps = 157
n_sim = 7056
mean_ion_number = 1.996856e+01
mean_ion = 1.376045e+00
stdv_ion = 3.593095e-01
mean_bkgnd = 3.629817e-01
stdv_bkgnd = 8.907480e-01

n_trials = 1000
n_decay_steps = 0
ion_distribution = "poisson"
noise_model = "quadrature"

stdv_ion_corr = 0.0
corr_bins = 0.0

empty_shots = false
empty_shots_probability = 0.0
limit = 1600
seed = 1

# ---- fit (RionSIS has already cut the first 40 ms: nothing to drop) ----
fit_drop = []
fit_t_start = 0.0
fit_weights = "model"                # "exp" = σ of the RionSIS fit (noise model, section 9): same weights for real and simulated fits | "none" | "model"
compare_t_starts = [0.0, 0.127]    # 0.127 s here = 167 ms after injection (first bin is at 39.7 ms)

# ---- bootstrap ----
bootstrap_n = 200
bootstrap_block = 5
bootstrap_trials = 10

[settings]
tasks = ['addup', 'mle']
output_path = "./out_mo"
output_tag = "rionsis_"
plot_every_event = false
save_npz = false
plot_titles = false
n_trial_plots = 3
